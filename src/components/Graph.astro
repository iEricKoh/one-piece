---
const bars = [
  { width: 90, label: "Claude Code / AI-assisted development" },
  { width: 85, label: "React / Angular / Flutter / Chrome extension" },
  { width: 75, label: "Tailwind / Bootstrap / Webpack / Vite" },
  { width: 63, label: "Node.js / TypeScript / Go" },
  { width: 42, label: "MongoDB / Postgres" },
]
---

{
  bars.map((bar) => (
    <div class="mb-5">
      <div class="mb-2" data-reveal>
        {bar.label}
      </div>
      <div
        class="bg-teal-400 h-5 bar"
        data-reveal
        style={`--bar-width:${bar.width}%`}
      />
    </div>
  ))
}
