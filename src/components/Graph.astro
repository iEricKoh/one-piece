---
const bars = [
  { width: 90, label: "Claude Code / AI-assisted development" },
  { width: 85, label: "React / Next.js / TypeScript / Flutter" },
  { width: 75, label: "Tailwind CSS / Vite / HTML / CSS" },
  { width: 63, label: "Node.js / Go / GraphQL" },
  { width: 42, label: "PostgreSQL / MongoDB / Redis" },
]
---

{
  bars.map((bar) => (
    <div class="mb-5">
      <div class="mb-2" data-reveal>
        {bar.label}
      </div>
      <div
        class="bg-teal-400 h-5 bar"
        data-reveal
        style={`--bar-width:${bar.width}%`}
      />
    </div>
  ))
}
