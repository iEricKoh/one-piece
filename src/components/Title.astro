---
const phrases = [
  "Senior Frontend Engineer",
  "Product-Minded Developer",
  "Professional Vibe Coder",
  "Senior Frontend & AI Engineer",
]
---

<span
  class="tw-cursor inline-block"
  data-title
  data-phrases={JSON.stringify(phrases)}
>
  {phrases[phrases.length - 1]}
</span>

<script>
  import { typewriter } from "@/scripts/typewriter"

  document.querySelectorAll<HTMLElement>("[data-title]").forEach((el) => {
    const phrases: string[] = JSON.parse(el.dataset.phrases ?? "[]")

    // Pause the loop while scrolled offscreen; wake it when it returns.
    let onScreen = true
    if ("IntersectionObserver" in window) {
      const io = new IntersectionObserver((entries) => {
        for (const entry of entries) {
          onScreen = entry.isIntersecting
          if (onScreen) el.dispatchEvent(new Event("typewriter:resume"))
        }
      })
      io.observe(el)
    }

    typewriter(el, phrases, {
      speed: 55,
      deleteSpeed: 30,
      pause: 1000,
      loop: true,
      paused: () => !onScreen,
    })
  })
</script>
