---
import Icon from "./Icon.astro"
import Title from "./Title.astro"
import { useTranslations } from "@/i18n/utils"
import type { Locale } from "@/i18n/config"

const { locale } = Astro.props as { locale: Locale }
const t = useTranslations(locale, "cv")
---

<div class="flex flex-col md:flex-row md:items-end justify-between gap-6">
  <hgroup>
    <h1 class="text-5xl md:text-8xl font-bold uppercase">{t("fullname")}</h1>
    <h4 class="text-xl md:text-3xl mt-3 text-teal-600 dark:text-teal-400">
      <Title locale={locale} />
    </h4>
  </hgroup>
  <address class="md:text-lg text-left not-italic shrink-0">
    <a
      class="mb-2 flex items-center"
      href="mailto:akaerickoh@gmail.com?subject=What's up"
    >
      <span class="mr-2 md:mr-3 inline-flex"><Icon name="email" /></span>
      <span>akaerickoh@gmail.com</span>
    </a>
    <a class="mb-2 flex items-center" href="tel:+19366666010">
      <span class="mr-2 md:mr-3 inline-flex"><Icon name="phone" /></span>
      <span>+1 9366666010</span>
    </a>
    <div class="flex items-center">
      <span class="mr-2 md:mr-3 inline-flex"><Icon name="location" /></span>
      <span>{t("address")}</span>
    </div>
  </address>
</div>
