---
import Title from "./Title.astro"
import { useTranslations } from "@/i18n/utils"

const t = useTranslations()
---

<hgroup>
  <h1
    class="text-5xl md:text-8xl font-bold uppercase tracking-tight leading-none"
  >
    {t("fullname")}
  </h1>
  <h4 class="text-xl md:text-3xl mt-4 text-teal-600 dark:text-teal-400">
    <Title />
  </h4>
</hgroup>
