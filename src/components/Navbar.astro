---
import Icon from "./Icon.astro"
import ThemeToggle from "./ThemeToggle.astro"
import LanguageToggle from "./LanguageToggle.astro"

const links = [
  {
    icon: "linkedin",
    url: "https://www.linkedin.com/in/ierickoh",
    label: "LinkedIn",
  },
  { icon: "github", url: "https://github.com/iEricKoh", label: "GitHub" },
]
---

<header class="antialiased bg-white dark:bg-slate-900 top-0 w-full">
  <nav class="max-w-screen-xl mx-auto px-4 md:px-10 py-3">
    <div class="flex justify-between items-center">
      <a href="/" class="text-2xl font-bold text-gray-800"></a>
      <div class="flex items-center space-x-4">
        {
          links.map((link) => (
            <a
              href={link.url}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={link.label}
              class="p-2 rounded-full hover:bg-gray-200 dark:hover:bg-teal-400 transition-all text-2xl"
            >
              <Icon name={link.icon} />
            </a>
          ))
        }
        <ThemeToggle />
        <LanguageToggle />
      </div>
    </div>
  </nav>
</header>
