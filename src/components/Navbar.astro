---
import Icon from "./Icon.astro"
import ThemeToggle from "./ThemeToggle.astro"

const links = [
  {
    icon: "email",
    url: "mailto:akaerickoh@gmail.com?subject=What's up",
    label: "Email",
    external: false,
  },
  {
    icon: "linkedin",
    url: "https://www.linkedin.com/in/ierickoh",
    label: "LinkedIn",
    external: true,
  },
  {
    icon: "github",
    url: "https://github.com/iEricKoh",
    label: "GitHub",
    external: true,
  },
]
---

<header class="antialiased bg-white dark:bg-slate-900 top-0 w-full">
  <nav class="px-4 md:px-10 py-3">
    <div class="max-w-screen-xl mx-auto flex justify-between items-center">
      <a href="/" class="text-2xl font-bold text-gray-800"></a>
      <div class="flex items-center gap-4 -mr-2">
        {
          links.map((link) => (
            <a
              href={link.url}
              target={link.external ? "_blank" : undefined}
              rel={link.external ? "noopener noreferrer" : undefined}
              aria-label={link.label}
              class="p-2 rounded-full hover:bg-gray-200 dark:hover:bg-teal-400 transition-all text-2xl"
            >
              <Icon name={link.icon} />
            </a>
          ))
        }
        <ThemeToggle />
      </div>
    </div>
  </nav>
</header>
