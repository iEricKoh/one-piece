---
interface Props {
  heading: string
}

const { heading } = Astro.props
---

<h2
  class="mb-3 flex items-center text-sm md:text-base font-semibold uppercase tracking-[0.2em] text-teal-600 dark:text-teal-400"
>
  <span class="mr-2.5 inline-flex text-base md:text-lg"><slot /></span>
  {heading}
</h2>
<hr class="mb-6 border-slate-200 dark:border-slate-800" />
